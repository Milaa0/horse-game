@page
@model IndexModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <title>T-Horse Game</title>
    <style>
            body {
                background-color: white;
                display: flex;
                justify-content: center;
                margin: 0;
            }

            canvas {
                background-color: #ecf0f1;
                border: 4px solid #d69a90;
                border-radius: 8px;
                box-shadow: 0 10px 20px rgba(0,0,0,0.3);
                background: linear-gradient(to bottom, #ecf0f1 80%, #c08070 80%);
                margin-top: 50px;
            }
    </style>
</head>
<body>

    <div class="text-center">
        <canvas id="gameCanvas" width="800" height="300"></canvas>
    </div>

    <!-- Ładowanie głównego pliku JS -->
    <script type="module" src="~/js/main.js"></script>

</body>
</html>